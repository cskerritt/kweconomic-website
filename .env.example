# Public website (root server.js) environment variables.
# All are optional for local dev; set them on the Railway "website" service.

# Force a single canonical hostname (301-redirects www / *.up.railway.app to it).
CANONICAL_HOST=kwvrs.com

# Intake workflow service: form submissions are forwarded here (POST /api/case).
# Leave unset locally to skip forwarding. WORKFLOW_FORWARD_TOKEN must match the
# value set on the workflow service (see workflow/.env.example for that side).
WORKFLOW_URL=
WORKFLOW_FORWARD_TOKEN=

# Cloudflare Turnstile (anti-spam on /api/consultation + /api/contact).
# VITE_TURNSTILE_SITE_KEY is inlined at BUILD time (Vite), so it must be set on
# the website service BEFORE the build/deploy or the widget is omitted.
# TURNSTILE_SECRET_KEY is read by server.js at runtime. Verification is
# FAIL-OPEN: with either unset (or on a Cloudflare outage) the form still works.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PORT is provided by Railway automatically; defaults to 3000 locally.
# PORT=3000

# Durable lead capture (Phase 0). Point at the SAME Supabase project the
# workflow service uses. SECURITY: PUBLIC_SUPABASE_SERVICE_ROLE_KEY is
# full-access - server-side only, never imported into src/ React code.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_SERVICE_ROLE_KEY=

# Replay sweep tuning (Phase 0, optional). Defaults: 300000ms / 10 attempts.
REPLAY_INTERVAL_MS=300000
REPLAY_MAX_ATTEMPTS=10

# Clio Grow Lead Inbox token for the /raffle QR pipeline. Clio Grow -> Settings
# -> Lead Inbox -> copy the inbox token. UNSET is safe: the raffle page still
# works and every entry is still stored locally; the Grow push simply logs
# "raffle Grow push skipped (no-token)" and the entry keeps growDelivered:false
# for a later resweep. (The workflow service reads a variable of the same name
# for its own attorney-lead push; these are two services, set it on both.)
CLIO_GROW_INBOX_TOKEN=

# Raffle ledger path. Defaults to data/raffle-entries.jsonl, which is EPHEMERAL
# on Railway - point this at an attached volume before an event so the entries
# survive a deploy, because the drawing reads this file.
RAFFLE_ENTRIES_FILE=

# Public base URL used as the Clio Grow lead's referring_url (defaults to
# https://kwvrs.com).
SITE_BASE_URL=

# Form-API rate limit, requests per minute per IP (default 10). This one is
# GLOBAL to every form API, so do NOT raise it for a conference - that would
# loosen /api/contact and the rest for every IP on the internet.
RATE_LIMIT_MAX=

# Rate limit for /api/raffle ONLY, requests per minute per IP (defaults to
# RATE_LIMIT_MAX). This is the conference dial: a booth puts every attendee
# behind ONE NAT address, so the 11th scan in a minute would otherwise 429 a
# real entrant. Raising it leaves every other form API at the global limit.
RAFFLE_RATE_LIMIT_MAX=
