# Public website (root server.js) environment variables.
# All are optional for local dev; set them on the Railway "website" service.

# Force a single canonical hostname (301-redirects www / *.up.railway.app to it).
# Unset or empty = redirect OFF (local dev, the Docker smoke, and the Railway
# staging URL before the DNS cutover). Set it at cutover - never before the
# apex domain points at the service.
CANONICAL_HOST=kweconomics.com

# Lead delivery (Resend). Every accepted form POST is emailed to LEAD_RECIPIENTS
# (comma-separated) from LEAD_FROM; consultations also get a visitor ack.
# RESEND_API_KEY unset = email skipped (logged); leads still land in
# raw_submissions + data/submissions.jsonl. /healthz reports `mail`.
LEAD_RECIPIENTS=info@kwvrs.com
LEAD_FROM="KW Economics <info@kwvrs.com>"
RESEND_API_KEY=

# Cloudflare Turnstile (anti-spam on every /api/* lead form).
# VITE_TURNSTILE_SITE_KEY is inlined at BUILD time (Vite), so it must be set on
# the website service BEFORE the build/deploy or the widget is omitted.
# TURNSTILE_SECRET_KEY is read by server.js at runtime. Verification is
# FAIL-OPEN: with either unset (or on a Cloudflare outage) the form still works.
# TURNSTILE_REQUIRE_TOKEN=true also rejects tokenless POSTs.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRE_TOKEN=

# Durable lead capture (Supabase raw_submissions). SECURITY:
# PUBLIC_SUPABASE_SERVICE_ROLE_KEY is full-access - server-side only, never
# imported into src/ React code.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_SERVICE_ROLE_KEY=

# Form-API rate limit, requests per minute per IP (default 10).
RATE_LIMIT_MAX=

# PORT is provided by Railway automatically; defaults to 3000 locally.
# PORT=3000
