  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs && node scripts/generate-extra-sitemaps.mjs && tsc -b && vite build && node scripts/prerender.mjs",
